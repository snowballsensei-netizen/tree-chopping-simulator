rules_version = '2';
// Tree Chopping Simulator — paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // the admin is whoever owns the username "shiv"
    function isShiv() {
      return signedIn()
        && exists(/databases/$(database)/documents/usernames/shiv)
        && get(/databases/$(database)/documents/usernames/shiv).data.uid == request.auth.uid;
    }
    // accounts use <username>@players.treechopping.game, so a user can only claim their own name
    function ownsName(lower) {
      return request.auth.token.email == lower + '@players.treechopping.game';
    }
    function num(v) { return v is int || v is float; }

    // uniqueness: usernames/{lowercase} = {uid, username}; create-only
    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{4,16}$')
        && ownsName(name)
        && request.resource.data.keys().hasOnly(['uid', 'username'])
        && request.resource.data.keys().hasAll(['uid', 'username'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.lower() == name;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'usernameLower'])
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.username.lower() == request.resource.data.usernameLower
        && ownsName(request.resource.data.usernameLower);
      allow delete: if false;

      // save slots 0..2
      match /slots/{slot} {
        allow read: if isOwner(uid) || isShiv();
        allow create, update: if isOwner(uid)
          && slot in ['0', '1', '2']
          && request.resource.data.keys().hasOnly(['uid', 'username', 'usernameLower', 'slot', 'lastSaved', 'profileName',
               'wood', 'lifetimeWood', 'rebirths', 'speciesIndex', 'playTime', 'data'])
          && request.resource.data.uid == uid
          && request.resource.data.username is string && request.resource.data.username.size() <= 16
          && request.resource.data.usernameLower is string && ownsName(request.resource.data.usernameLower)
          && request.resource.data.slot is int && string(request.resource.data.slot) == slot
          && num(request.resource.data.lastSaved)
          && request.resource.data.profileName is string && request.resource.data.profileName.size() <= 20
          && num(request.resource.data.wood) && num(request.resource.data.lifetimeWood)
          && num(request.resource.data.rebirths) && num(request.resource.data.speciesIndex) && num(request.resource.data.playTime)
          && request.resource.data.data is string && request.resource.data.data.size() < 400000;
        allow delete: if isOwner(uid);
      }

      // admin grants: Shiv creates, the owner's client reads (gives/takes logs or acorns) and deletes.
      // amount > 0 gives, < 0 takes; kind 'logs' (default when missing), 'acorns' or 'rebirths' (whole numbers)
      match /grants/{gid} {
        allow read, delete: if isOwner(uid);
        allow create: if isShiv()
          && request.resource.data.keys().hasOnly(['slot', 'amount', 'kind', 'by', 'at'])
          && request.resource.data.slot in [0, 1, 2]
          && num(request.resource.data.amount) && request.resource.data.amount != 0
          && (!('kind' in request.resource.data) || request.resource.data.kind == 'logs'
            || (request.resource.data.kind == 'acorns' && request.resource.data.amount is int)
            || (request.resource.data.kind == 'rebirths' && request.resource.data.amount is int
                && request.resource.data.amount >= -1000 && request.resource.data.amount <= 1000))
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time;
        allow update: if false;
      }
    }

    /* ---------- friends ---------- */
    // friendReqs/{from}_{to} = {from, to, fromName, at}: the sender creates, sender or recipient reads/deletes (decline, cancel, accept cleanup)
    match /friendReqs/{rid} {
      allow read: if signedIn() && (resource == null || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'at'])
        && request.resource.data.keys().hasAll(['from', 'to', 'fromName', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && rid == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.fromName is string && ownsName(request.resource.data.fromName.lower())
        && request.resource.data.at == request.time
        && !exists(/databases/$(database)/documents/friends/$(request.auth.uid)/list/$(request.resource.data.to));
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if false;
    }
    // friends/{owner}/list/{other} = {uid: other, username, at}. Only the RECIPIENT of a pending request can create
    // both sides (one batch that also deletes the request). Either friend can delete both sides (remove friend).
    match /friends/{owner}/list/{other} {
      allow read: if isOwner(owner);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'at'])
        && request.resource.data.keys().hasAll(['uid', 'username', 'at'])
        && request.resource.data.uid == other && other != owner
        && request.resource.data.at == request.time
        && request.resource.data.username is string && request.resource.data.username.size() <= 16
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == other
        && ((request.auth.uid == owner && exists(/databases/$(database)/documents/friendReqs/$(other + '_' + owner)))
          || (request.auth.uid == other && exists(/databases/$(database)/documents/friendReqs/$(owner + '_' + other))));
      allow update: if false;
      allow delete: if isOwner(owner) || isOwner(other);
    }
    // presence/{uid} = {username, lastSeen, wood, acorns}: online dot + the balances the duel rules check
    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'lastSeen', 'wood', 'acorns'])
        && request.resource.data.keys().hasAll(['username', 'lastSeen', 'wood', 'acorns'])
        && request.resource.data.username is string && ownsName(request.resource.data.username.lower())
        && request.resource.data.lastSeen == request.time
        && num(request.resource.data.wood) && num(request.resource.data.acorns);
      allow delete: if false;
    }

    // leaderboard/{uid} = {username, wins, logs, rebirths, acorns, at}: public (the title menu shows it before login),
    // written only by the owner under their own name. Sanity: whole numbers for wins/rebirths/acorns, rebirths <= 1000,
    // wins grow by at most 20 per write.
    match /leaderboard/{uid} {
      function L() { return request.resource.data; }
      function okInt(v, cap) { return v is int && v >= 0 && v <= cap; }
      allow read: if true;
      // the owner writes their own entry; the admin (Shiv) may backfill anyone's entry from their saves,
      // but only under the username that uid really owns
      allow create, update: if signedIn()
        && L().keys().hasOnly(['username', 'wins', 'logs', 'rebirths', 'acorns', 'at'])
        && L().keys().hasAll(['username', 'wins', 'logs', 'rebirths', 'acorns', 'at'])
        && L().username is string && L().username.size() <= 16
        && ((isOwner(uid) && ownsName(L().username.lower()))
          || (isShiv() && get(/databases/$(database)/documents/usernames/$(L().username.lower())).data.uid == uid))
        && okInt(L().wins, 1000000) && okInt(L().rebirths, 1000) && okInt(L().acorns, 100000000)
        && num(L().logs) && L().logs >= 0
        && (resource == null || L().wins <= resource.data.wins + 20)
        && L().at == request.time;
      allow delete: if false;
    }

    /* ---------- duels ---------- */
    // duels/{id}: a = challenger, b = challenged. status pending -> accepted -> done (or declined / cancelled).
    // pa/pb = chops (only that player writes it, with ta/tb = request.time), winner set once in a transaction,
    // paidA/paidB = that player's client applied the payout. Keep 250 / 20 / 4.5 / 120 / 15 in sync with js/data.js DUEL_*.
    // aStage/aCos (challenger, at create) and bStage/bCos (challenged, at accept) = stage 0..7 + equipped cosmetics 'hat|face|boots' (looks only).
    match /duels/{id} {
      function O() { return resource.data; }
      function N() { return request.resource.data; }
      function changed() { return N().diff(O()).affectedKeys(); }
      function involved() { return signedIn() && (O().a == request.auth.uid || O().b == request.auth.uid); }
      function field(kind) { return kind == 'logs' ? 'wood' : 'acorns'; }
      function hasFunds(uid, kind, amount) {
        return get(/databases/$(database)/documents/presence/$(uid)).data[field(kind)] >= amount;
      }
      // v2 duels carry aStage (3D duel: 250 chops, 4.5 s intro+countdown); older docs without it keep v1 (100 chops, 3 s)
      function v2() { return 'aStage' in O(); }
      function hp() { return v2() ? 250 : 100; }
      function goSec() { return v2() ? 4.5 : 3.0; }
      // anti-cheat: at most 20 chops/s since GO (startAt + goSec), +5 slack
      function cap() { return 20.0 * ((request.time.toMillis() - O().startAt.toMillis()) / 1000.0 - goSec()) + 5.0; }
      function okLook(s, c) { return s is int && s >= 0 && s < 8 && c is string && c.size() <= 48; }
      function okChops(p) {
        return N()[p] is int && N()[p] >= O()[p] && N()[p] <= hp() && (N()[p] == O()[p] || N()[p] <= cap());
      }
      function progress(side, p, t) {
        return request.auth.uid == O()[side] && O().status == 'accepted' && N().status == 'accepted'
          && changed().hasOnly([p, t]) && N()[t] == request.time && okChops(p);
      }
      // first finisher (250 chops) or forfeit: the opponent sent nothing for 15 s after GO (GO = startAt + 4.5 s)
      function finish(side, p, t, ot) {
        return request.auth.uid == O()[side] && O().status == 'accepted' && N().status == 'done'
          && changed().hasOnly(['status', 'winner', 'endAt', p, t])
          && N().winner == request.auth.uid && N().endAt == request.time && N()[t] == request.time && okChops(p)
          && (N()[p] == hp() || (request.time > O()[ot] + duration.value(15, 's') && request.time > O().startAt + duration.value(v2() ? 19500 : 18000, 'ms')));
      }
      function paid(side, f) {
        return request.auth.uid == O()[side] && O().status == 'done' && changed().hasOnly([f]) && N()[f] == true;
      }
      function accept() {
        return request.auth.uid == O().b && O().status == 'pending' && N().status == 'accepted'
          && request.time < O().createdAt + duration.value(120, 's')
          && changed().hasOnly(['status', 'startAt', 'ta', 'tb', 'bStage', 'bCos'])
          && (v2() ? okLook(N().bStage, N().bCos) : !('bStage' in N()))
          && N().startAt == request.time && N().ta == request.time && N().tb == request.time
          && hasFunds(O().a, O().kind, O().amount) && hasFunds(O().b, O().kind, O().amount);
      }
      function decline() {
        return request.auth.uid == O().b && O().status == 'pending' && N().status == 'declined' && changed().hasOnly(['status']);
      }
      // the challenger withdraws, or either player aborts during the countdown (e.g. funds gone)
      function cancel() {
        return N().status == 'cancelled' && changed().hasOnly(['status'])
          && ((O().status == 'pending' && request.auth.uid == O().a)
            || (O().status == 'accepted' && request.time < O().startAt + duration.value(v2() ? 4500 : 3000, 'ms')));
      }

      allow read: if signedIn() && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
      allow create: if signedIn()
        && N().keys().hasOnly(['a', 'b', 'aName', 'bName', 'kind', 'amount', 'status', 'createdAt', 'startAt', 'ta', 'tb', 'pa', 'pb', 'winner', 'endAt', 'paidA', 'paidB', 'aStage', 'aCos'])
        && N().keys().hasAll(['a', 'b', 'aName', 'bName', 'kind', 'amount', 'status', 'createdAt', 'startAt', 'ta', 'tb', 'pa', 'pb', 'winner', 'endAt', 'paidA', 'paidB'])
        && (('aStage' in N() || 'aCos' in N()) ? okLook(N().aStage, N().aCos) : true)
        && N().a == request.auth.uid && N().b is string && N().b != request.auth.uid
        && exists(/databases/$(database)/documents/friends/$(request.auth.uid)/list/$(N().b))
        && N().aName is string && ownsName(N().aName.lower()) && N().bName is string && N().bName.size() <= 16
        && N().status == 'pending' && N().kind in ['logs', 'acorns']
        && num(N().amount) && N().amount > 0 && (N().kind == 'logs' || N().amount is int)
        && N().createdAt == request.time && N().startAt == null && N().ta == null && N().tb == null && N().endAt == null
        && N().pa == 0 && N().pb == 0 && N().winner == '' && N().paidA == false && N().paidB == false
        && hasFunds(N().a, N().kind, N().amount) && hasFunds(N().b, N().kind, N().amount);
      allow update: if involved() && (accept() || decline() || cancel()
        || progress('a', 'pa', 'ta') || progress('b', 'pb', 'tb')
        || finish('a', 'pa', 'ta', 'tb') || finish('b', 'pb', 'tb', 'ta')
        || paid('a', 'paidA') || paid('b', 'paidB'));
      allow delete: if involved() && (O().status in ['declined', 'cancelled'] || (O().status == 'done' && O().paidA && O().paidB)
        || (O().status == 'pending' && request.time > O().createdAt + duration.value(120, 's')));
    }

    // friend chat: chats/{a}_{b} (uids sorted) = {members:[a,b], last, lastFrom, lastAt}; chats/{pair}/msgs/{id} = {from, text, at}.
    // Only the two members, while friends, read or write. Messages are 1-120 chars and never edited or deleted.
    match /chats/{pair} {
      function ids() { return pair.split('_'); }
      function isMember() { return signedIn() && ids().size() == 2 && (ids()[0] == request.auth.uid || ids()[1] == request.auth.uid); }
      function other() { return ids()[0] == request.auth.uid ? ids()[1] : ids()[0]; }
      function isFriend() { return exists(/databases/$(database)/documents/friends/$(request.auth.uid)/list/$(other())); }
      function okText(t) { return t is string && t.size() >= 1 && t.size() <= 120; }
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update: if isMember() && isFriend() && ids()[0] < ids()[1]
        && request.resource.data.keys().hasOnly(['members', 'last', 'lastFrom', 'lastAt'])
        && request.resource.data.members == ids()
        && okText(request.resource.data.last) && request.resource.data.lastFrom == request.auth.uid
        && request.resource.data.lastAt == request.time;
      allow delete: if false;
      match /msgs/{id} {
        allow read: if isMember();
        allow create: if isMember() && isFriend()
          && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.from == request.auth.uid && okText(request.resource.data.text)
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    // global announcement: anyone reads, only the admin (Shiv) posts {text 1-140 chars, at = server time, by = own uid}
    match /meta/announcement {
      allow read: if true;
      allow create, update: if isShiv() && request.resource.data.keys().hasOnly(['text', 'at', 'by'])
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 140
        && request.resource.data.at == request.time && request.resource.data.by == request.auth.uid;
      allow delete: if isShiv();
    }

    // admin player list: collection-group query over every slots collection
    match /{path=**}/slots/{slot} {
      allow read: if isShiv();
    }
  }
}
